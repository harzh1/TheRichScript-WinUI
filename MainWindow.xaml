<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TheRichScript_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TheRichScript_WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="RichScript by Santara"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" KeyDown="RootGrid_KeyDown" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native TitleBar control (graduated from CommunityToolkit.Labs into Windows App SDK) -->
        <TitleBar x:Name="AppTitleBar"
                  Title="RichScript"
                  Subtitle="by Santara"
                  IsBackButtonVisible="True"
                  IsBackButtonEnabled="False"
                  IsPaneToggleButtonVisible="False"
                  BackRequested="AppTitleBar_BackRequested"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <!-- TitleBar dimensions and spacing metrics -->
                <x:Double x:Key="TitleBarCompactHeight">44</x:Double>
                <x:Double x:Key="TitleBarLeftHeaderPaddingWidth">8</x:Double>
                <Thickness x:Key="TitleBarIconMargin">0,0,6,0</Thickness>
                <Thickness x:Key="TitleBarTitleMargin">0,1,6,0</Thickness>
                <Thickness x:Key="TitleBarSubtitleMargin">0,1,12,0</Thickness>

                <!-- Button background overrides (transparent disabled state) -->
                <SolidColorBrush x:Key="TitleBarBackButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TitleBarBackButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="TitleBarPaneToggleButtonBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TitleBarPaneToggleButtonBackgroundDisabled" Color="Transparent" />
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <BitmapIconSource ShowAsMonochrome="False"
                                  UriSource="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Root Navigation Frame -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
