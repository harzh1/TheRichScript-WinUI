<Page
    x:Class="TheRichScript_WinUI.Views.CategoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,0">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- 1. Compact Header Row (Title on Left, Actions on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Categories &amp; Budget Limits" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddCategory_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add Category" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadCategoriesCommand}" ToolTipService.ToolTip="Refresh Categories">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. Summary KPI Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Categories -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL CATEGORIES" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A6366F1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8FD;" FontSize="11" Foreground="#6366F1" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalCategoriesCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#6366F1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Budgeted Categories Count -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="BUDGETED CATEGORIES" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A38BDF8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE809;" FontSize="11" Foreground="#38BDF8" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.BudgetedCategoriesCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Total Monthly Budget Cap -->
                <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL MONTHLY BUDGET CAP" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEAFC;" FontSize="11" Foreground="#10B981" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalMonthlyBudgetCap, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#10B981" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Current Month Spending in Budgeted -->
                <Border Grid.Column="3" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MONTH SPENDING IN BUDGETS" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1AF43F5E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEF42;" FontSize="11" Foreground="#F43F5E" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.CurrentMonthSpending, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#F43F5E" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. All Categories & Limit Settings Section using StaggeredLayout -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="16,14">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="All Categories &amp; Limit Settings" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="No categories yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="{x:Bind ViewModel.Categories.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <!-- Staggered Layout for Category Cards -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="280" MaxColumns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Category">
                                <Border Style="{StaticResource FluentSubtleCardStyle}" Padding="14,12" CornerRadius="8">
                                    <StackPanel Spacing="10">
                                        <!-- Top Row: Category Name + Status Tag + Edit/Delete Buttons -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border Visibility="{x:Bind HasMonthlyLimit, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind LimitStatusText}" FontSize="8" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Padding="4" Background="Transparent" BorderThickness="0" Click="EditCategory_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Edit Category / Limits">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                                <Button Padding="4" Background="Transparent" BorderThickness="0" Click="DeleteCategory_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Delete Category">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- When Monthly Limit is Configured -->
                                        <StackPanel Visibility="{x:Bind HasMonthlyLimit, Converter={StaticResource BooleanToVisibilityConverter}}" Spacing="6">
                                            <Grid>
                                                <TextBlock Text="Monthly Spent" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="{x:Bind FormattedSpentVsLimit}" />
                                                </TextBlock>
                                            </Grid>

                                            <ProgressBar Value="{x:Bind LimitPercentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                            <TextBlock FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right">
                                                <Run Text="{x:Bind LimitPercentage, Converter={StaticResource PercentTextConverter}}" /><Run Text=" used" />
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- When No Monthly Limit is Set -->
                                        <StackPanel Visibility="{x:Bind HasMonthlyLimit, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" Spacing="2" Margin="0,2">
                                            <TextBlock Text="No Monthly Limit" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <!-- Yearly Limit if present -->
                                        <Border Visibility="{x:Bind YearlyLimit, Converter={StaticResource NullToVisibilityConverter}}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                            <Grid>
                                                <TextBlock Text="Yearly Cap" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind YearlyLimit, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
