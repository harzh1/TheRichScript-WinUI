<Page
    x:Class="TheRichScript_WinUI.Views.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    xmlns:local="using:TheRichScript_WinUI.Views"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- 1. Header Row (Title on Left, Actions on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Financial Goals" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddGoal_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="New Goal" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadGoalsCommand}" ToolTipService.ToolTip="Refresh Goals">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. Summary KPI Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Total Goals Target -->
                <controls:KpiCardControl
                    Grid.Column="0"
                    Title="Total Target"
                    Value="{x:Bind ViewModel.TotalTargetAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Cumulative savings objective"
                    Glyph="&#xE706;"
                    ShowActionIcon="False" />

                <!-- 2. Total Saved So Far -->
                <controls:KpiCardControl
                    Grid.Column="1"
                    Title="Total Saved"
                    Value="{x:Bind ViewModel.TotalSavedAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Accumulated goal savings"
                    Glyph="&#xEAFC;"
                    ShowActionIcon="False" />

                <!-- 3. Remaining To Save -->
                <controls:KpiCardControl
                    Grid.Column="2"
                    Title="Remaining"
                    Value="{x:Bind ViewModel.RemainingTargetAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Outstanding balance to achieve"
                    Glyph="&#xE916;"
                    ShowActionIcon="False" />

                <!-- 4. Overall Progress -->
                <controls:KpiCardControl
                    Grid.Column="3"
                    Title="Overall Progress"
                    Value="{x:Bind ViewModel.OverallProgressPercentage, Mode=OneWay, Converter={StaticResource PercentTextConverter}}"
                    Subtitle="Portfolio completion rate"
                    Glyph="&#xE73E;"
                    ShowActionIcon="False" />
            </Grid>

            <!-- 3. Search & Filter Bar Card -->
            <Border Style="{StaticResource FluentSubtleCardStyle}" Padding="12,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Search goals by name..."
                             VerticalAlignment="Center" />

                    <!-- Status Filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{x:Bind ViewModel.StatusFilters, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedStatusFilter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 4. Empty State: No Goals Configured -->
            <Border Style="{StaticResource FluentCardStyle}"
                    Padding="32,40"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind local:GoalsPage.ShowNoGoalsEmptyState(ViewModel.TotalGoalsCount, ViewModel.IsLoading), Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE706;" FontSize="26" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No financial goals yet" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Set target amounts for savings, investments, or major purchases and track your progress over time." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddGoal_Click" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Create Your First Goal" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 5. Empty State: Filter / Search Returned 0 Results -->
            <Border Style="{StaticResource FluentCardStyle}"
                    Padding="32,32"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind local:GoalsPage.ShowFilterEmptyState(ViewModel.TotalGoalsCount, ViewModel.FilteredGoals.Count, ViewModel.IsLoading), Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No matching goals found" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No goals match your search query or selected filter. Try adjusting your search criteria." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <Button Style="{StaticResource SmallHeaderButtonStyle}" Click="ClearFilter_Click" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="Clear Filter" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 6. Goals Grid Cards with Matrix Wrap -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredGoals, Mode=OneWay}"
                          Visibility="{x:Bind local:GoalsPage.ShowGoalsList(ViewModel.FilteredGoals.Count), Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="265" MaxColumns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Goal">
                        <controls:GoalCardControl Goal="{x:Bind}"
                                                  DepositFundsClicked="GoalCard_DepositFundsClicked"
                                                  TogglePinClicked="GoalCard_TogglePinClicked"
                                                  EditGoalClicked="GoalCard_EditGoalClicked"
                                                  DeleteGoalClicked="GoalCard_DeleteGoalClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
