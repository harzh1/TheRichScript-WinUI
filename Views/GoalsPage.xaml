<Page
    x:Class="TheRichScript_WinUI.Views.GoalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,0">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- Compact Header Row (Title on Left, Actions on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Financial Goals" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddGoal_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="New Goal" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadGoalsCommand}" ToolTipService.ToolTip="Refresh Goals">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Summary KPI Strip: 3 Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL GOALS TARGET" Style="{StaticResource StatLabelTextStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.TotalTargetAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL SAVED SO FAR" Style="{StaticResource StatLabelTextStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.TotalSavedAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="OVERALL PROGRESS" Style="{StaticResource StatLabelTextStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.OverallProgressPercentage, Mode=OneWay, Converter={StaticResource PercentTextConverter}}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Empty State -->
            <TextBlock Text="No financial goals yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,12" Visibility="{x:Bind ViewModel.Goals.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

            <!-- Goals Grid Cards with Slideshow Support & Clean Matrix Wrap -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Goals, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:StaggeredPanel ColumnSpacing="14" RowSpacing="14" DesiredColumnWidth="360" MaxColumns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Goal">
                        <controls:GoalCardControl Goal="{x:Bind}"
                                                  CurrencySymbol="₹"
                                                  DepositFundsClicked="GoalCard_DepositFundsClicked"
                                                  TogglePinClicked="GoalCard_TogglePinClicked"
                                                  DeleteGoalClicked="GoalCard_DeleteGoalClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
