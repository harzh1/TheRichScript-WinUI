<Page
    x:Class="TheRichScript_WinUI.Views.IncomeSourcesPage"
    x:Name="IncomeSourcesRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
        <StackPanel Spacing="16" MaxWidth="1400">

            <!-- 1. Header Row (Title on Left, Actions on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Income Streams &amp; Sources" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddIncomeSource_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add Income Source" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadIncomeSourcesCommand}" ToolTipService.ToolTip="Refresh Income Sources">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. KPI Summary Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Active Inflows -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ACTIVE INFLOW (EST. / MO)" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEAFC;" FontSize="11" Foreground="#10B981" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalActiveMonthly, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#10B981" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Passive Inflows -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PASSIVE INFLOW (EST. / MO)" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A6366F1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D4;" FontSize="11" Foreground="#6366F1" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalPassiveMonthly, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#6366F1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Combined Estimated Monthly Inflow -->
                <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TOTAL PROJECTED / MO" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A38BDF8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="#38BDF8" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalExpectedMonthly, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Received This Month -->
                <Border Grid.Column="3" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RECEIVED THIS MONTH" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1AF59E0B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE809;" FontSize="11" Foreground="#F59E0B" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalReceivedThisMonth, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#F59E0B" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Search & Filter Bar Card -->
            <Border Style="{StaticResource FluentSubtleCardStyle}" Padding="12,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search income sources by name, note, or account..." VerticalAlignment="Center" />

                    <!-- Classification Filter -->
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.TypeFilterOptions}" SelectedItem="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="All Types" />
                </Grid>
            </Border>

            <!-- 4. Income Streams Grid Card -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="16,14">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="All Configured Income Streams" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Empty State -->
                    <TextBlock Text="No income sources found. Click 'Add Income Source' to define active salaries, freelance gigs, or passive assets." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="{x:Bind ViewModel.IncomeSources.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <!-- Staggered Layout for Income Sources -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.IncomeSources, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="320" MaxColumns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:IncomeSource">
                                <Border Style="{StaticResource FluentCardStyle}" Padding="16,14" CornerRadius="10">
                                    <StackPanel Spacing="12">
                                        <!-- 1. Header: Modern Themed Icon Badge + Name + Classification Badges + Action Buttons -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <!-- Icon Badge (Themed Tint) -->
                                                <Border Width="38" Height="38" CornerRadius="8" Background="{x:Bind TypeIconBackground}" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image Source="{x:Bind IconUrl}" Stretch="UniformToFill" Visibility="{x:Bind HasIcon, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <FontIcon Glyph="{x:Bind TypeIconGlyph}" FontSize="15" Foreground="{x:Bind TypeIconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind HasIcon, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                                    </Grid>
                                                </Border>

                                                <!-- Stream Name & Pill Badges -->
                                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="175" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <!-- Active / Passive Badge -->
                                                        <Border Background="{x:Bind TypeBadgeBackground}" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{x:Bind DisplayType}" FontSize="9" FontWeight="Bold" Foreground="{x:Bind TypeBadgeForeground}" />
                                                        </Border>

                                                        <!-- Fixed / Variable Badge -->
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{x:Bind DisplayNature}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Actions: Edit & Delete -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                                <Button Padding="5" Background="Transparent" BorderThickness="0" CornerRadius="4" Click="EditIncomeSource_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Edit Income Source">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                                <Button Padding="5" Background="Transparent" BorderThickness="0" CornerRadius="4" Command="{Binding Path=DataContext.DeleteIncomeSourceCommand, ElementName=IncomeSourcesRootPage}" CommandParameter="{x:Bind}" ToolTipService.ToolTip="Delete Income Source">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 2. Dual Stat Boxes (Expected Inflow & Total Received) -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Expected Inflow Box -->
                                            <Border Grid.Column="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                                <StackPanel Spacing="2">
                                                    <Grid>
                                                        <TextBlock Text="EXPECTED" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{x:Bind DisplayFrequency}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind ExpectedAmount, Converter={StaticResource CurrencyConverter}}" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Total Received Box -->
                                            <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,8">
                                                <StackPanel Spacing="2">
                                                    <Grid>
                                                        <TextBlock Text="TOTAL RECEIVED" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <Run Text="{x:Bind TransactionCount}" /><Run Text=" logs" />
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind TotalReceived, Converter={StaticResource CurrencyConverter}}" FontSize="15" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#10B981" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- 3. Footer: Account & Optional Description -->
                                        <StackPanel Spacing="4">
                                            <!-- Target Account Pill -->
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4" Visibility="{x:Bind DefaultAssetName, Converter={StaticResource NullToVisibilityConverter}}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8C7;" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind DefaultAssetName}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Description -->
                                            <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" Visibility="{x:Bind Description, Converter={StaticResource NullToVisibilityConverter}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
