<Page
    x:Class="TheRichScript_WinUI.Views.IncomeSourcesPage"
    x:Name="IncomeSourcesRootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
        <StackPanel Spacing="16" MaxWidth="1400">

            <!-- 1. Header Row (Title on Left, Actions on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Income Streams &amp; Sources" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddIncomeSource_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add Income Source" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadIncomeSourcesCommand}" ToolTipService.ToolTip="Refresh Income Sources">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. KPI Summary Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Active Inflows -->
                <!-- 1. Active Inflows -->
                <controls:KpiCardControl
                    Grid.Column="0"
                    Title="Active Inflow"
                    Value="{x:Bind ViewModel.TotalActiveMonthly, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Salary &amp; earned income"
                    Glyph="&#xEAFC;"
                    ShowActionIcon="False" />

                <!-- 2. Passive Inflows -->
                <controls:KpiCardControl
                    Grid.Column="1"
                    Title="Passive Inflow"
                    Value="{x:Bind ViewModel.TotalPassiveMonthly, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Dividends, rental &amp; interest"
                    Glyph="&#xE8D4;"
                    ShowActionIcon="False" />

                <!-- 3. Combined Estimated Monthly Inflow -->
                <controls:KpiCardControl
                    Grid.Column="2"
                    Title="Projected Inflow"
                    Value="{x:Bind ViewModel.TotalExpectedMonthly, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Combined estimated monthly"
                    Glyph="&#xE8EC;"
                    ShowActionIcon="False" />

                <!-- 4. Received This Month -->
                <controls:KpiCardControl
                    Grid.Column="3"
                    Title="Received This Month"
                    Value="{x:Bind ViewModel.TotalReceivedThisMonth, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Actual realized inflows"
                    Glyph="&#xE809;"
                    ShowActionIcon="False" />
            </Grid>

            <!-- 3. Search & Filter Bar Card -->
            <Border Style="{StaticResource FluentSubtleCardStyle}" Padding="12,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search income sources by name, note, or account..." VerticalAlignment="Center" />

                    <!-- Classification Filter -->
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.TypeFilterOptions}" SelectedItem="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="All Types" />
                </Grid>
            </Border>

            <!-- 4. Empty State: No Income Sources Configured -->
            <Border Style="{StaticResource FluentCardStyle}"
                    Padding="32,40"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.IncomeSources.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource SubtleFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xEAFC;" FontSize="26" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No income streams yet" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Define your salaries, freelance contracts, dividends, or recurring passive income to track your cash inflows." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddIncomeSource_Click" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add First Income Stream" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 5. Income Streams Grid Cards (Matching Goals Card Layout) -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.IncomeSources, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.IncomeSources.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="265" MaxColumns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:IncomeSource">
                        <Border CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Padding="16,14">
                            <StackPanel Spacing="10">
                                <!-- 1. Header: Stream Name + Badge + 3-Dots Menu -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <!-- Stream Name -->
                                        <TextBlock Text="{x:Bind Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   MaxWidth="170" />

                                        <!-- Type Badge (ACTIVE / PASSIVE) -->
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayType}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 3-Dots Options Menu -->
                                    <Button Grid.Column="1"
                                            Padding="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Options">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit Stream" Click="EditIncomeSource_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete Stream" Click="DeleteIncomeSource_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <!-- 2. Total Inflow / Balance Display -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind TotalReceived, Converter={StaticResource CurrencyConverter}}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI Variable Display"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                    <!-- Subtitle: Expected Inflow & Cadence -->
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <!-- Expected Amount (only when configured > 0) -->
                                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasExpectedAmount, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="Exp:" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind ExpectedAmount, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="•" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>

                                        <!-- Frequency -->
                                        <TextBlock Text="{x:Bind DisplayFrequency}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="•" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                        <!-- Transaction Count -->
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                            <Run Text="{x:Bind TransactionCount}" /><Run Text=" logs" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 3. Footer: Target Account & Date / Notes -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Target Asset Account Pill (if assigned) -->
                                    <Border Grid.Column="0"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            Visibility="{x:Bind DefaultAssetName, Converter={StaticResource NullToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8C7;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind DefaultAssetName}" FontSize="10" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Last Received Date -->
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind LastReceivedDisplay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
