<Page
    x:Class="TheRichScript_WinUI.Views.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,0">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- 1. Header Row (Title on Left, Compact Actions on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Accounts &amp; Portfolio" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddAsset_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Add Account" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderButtonStyle}" Click="TransferFunds_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE8AB;" FontSize="11" />
                            <TextBlock Text="Transfer" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadAssetsCommand}" ToolTipService.ToolTip="Refresh Assets">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. Portfolio KPI Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Portfolio Net Worth -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PORTFOLIO VALUE" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A38BDF8" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="#38BDF8" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalPortfolioValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Liquid Cash & Bank Balances -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="LIQUID CASH &amp; BANKS" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A10B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8C7;" FontSize="11" Foreground="#10B981" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.LiquidCashValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#10B981" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Investments & Growth -->
                <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="INVESTMENTS &amp; GROWTH" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1A6366F1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEAFC;" FontSize="11" Foreground="#6366F1" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.InvestedValue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#6366F1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Active Accounts Count -->
                <Border Grid.Column="3" Style="{StaticResource FluentCardStyle}" Padding="16,14">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ACTIVE ACCOUNTS" Style="{StaticResource StatLabelTextStyle}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Background="#1AF59E0B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE716;" FontSize="11" Foreground="#F59E0B" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.TotalAssetCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="#F59E0B" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Search & Filter Bar Card -->
            <Border Style="{StaticResource FluentSubtleCardStyle}" Padding="12,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search accounts by name or type..." VerticalAlignment="Center" />

                    <!-- Category Type Filter -->
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.AssetTypes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedTypeFilter, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="All Types" />
                </Grid>
            </Border>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,32" Visibility="{x:Bind ViewModel.FilteredAssets.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <FontIcon Glyph="&#xE825;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No accounts found" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Try adjusting your search or add a new account to your portfolio." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddAsset_Click" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="11" />
                        <TextBlock Text="Add First Account" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 4. Grouped Asset Categories with Masonry Cards -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.GroupedAssets, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssetGroup">
                        <Border Style="{StaticResource FluentCardStyle}" Margin="0,0,0,16" Padding="16,14">
                            <StackPanel Spacing="12">

                                <!-- Group Header Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Group Icon, Name & Count -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{x:Bind TypeName}" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Items.Count}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: Group Total Value & Allocation % -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TotalValue, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" FontSize="15" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="{x:Bind PercentageOfTotal, Converter={StaticResource PercentTextConverter}}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Asset Cards ItemsControl with StaggeredPanel ItemsPanel -->
                                <ItemsControl ItemsSource="{x:Bind Items}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="280" MaxColumns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Asset">
                                            <Border Style="{StaticResource FluentSubtleCardStyle}" Padding="14,12" CornerRadius="8">
                                                <StackPanel Spacing="10">

                                                    <!-- Card Header: Title & Actions -->
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Border Width="24" Height="24" CornerRadius="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                                <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorPrimaryBrush}" MaxWidth="160" VerticalAlignment="Center" />
                                                        </StackPanel>

                                                        <!-- Edit & Delete Buttons -->
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                                                            <Button Padding="4" Background="Transparent" BorderThickness="0" Click="EditAsset_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Edit Account">
                                                                <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Button>
                                                            <Button Padding="4" Background="Transparent" BorderThickness="0" Click="DeleteAsset_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Delete Account">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Balance Display -->
                                                    <TextBlock Text="{x:Bind Value, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                                    <!-- Card Footer: Type & Quantity -->
                                                    <Grid Margin="0,2,0,0">
                                                        <TextBlock Text="{x:Bind Type}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Visibility="{x:Bind Quantity, Converter={StaticResource NullToVisibilityConverter}}" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                            <Run Text="Qty: " /><Run Text="{x:Bind Quantity}" />
                                                        </TextBlock>
                                                    </Grid>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
