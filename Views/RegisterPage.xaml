<Page
    x:Class="TheRichScript_WinUI.Views.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="460"
                Margin="0,30,0,30"
                Style="{StaticResource FluentCardStyle}"
                Padding="32,28">

                <StackPanel Spacing="18">
                    <!-- Header -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,4">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                               Width="52" Height="52"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="Create Account" Style="{StaticResource PageHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Start tracking your finances with native Windows speed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Error InfoBar -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBoolConverter}}"
                        Severity="Error"
                        Title="Registration Error"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        IsClosable="False" />

                    <!-- Form Fields -->
                    <StackPanel Spacing="14">
                        <!-- Name Row -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="First Name *" Style="{StaticResource StatLabelTextStyle}" />
                                <TextBox x:Name="FirstNameBox" Text="{x:Bind ViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="John" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Last Name" Style="{StaticResource StatLabelTextStyle}" />
                                <TextBox x:Name="LastNameBox" Text="{x:Bind ViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Doe" />
                            </StackPanel>
                        </Grid>

                        <!-- Email -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Email Address *" Style="{StaticResource StatLabelTextStyle}" />
                            <TextBox x:Name="EmailBox" Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="john@example.com" />
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Password (min 6 chars) *" Style="{StaticResource StatLabelTextStyle}" />
                            <PasswordBox x:Name="PasswordBox" PlaceholderText="••••••••" PasswordRevealMode="Peek" KeyDown="PasswordBox_KeyDown" PasswordChanged="PasswordBox_PasswordChanged" />
                        </StackPanel>

                        <!-- Country & Currency -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Country" Style="{StaticResource StatLabelTextStyle}" />
                                <ComboBox x:Name="CountryComboBox"
                                          ItemsSource="{x:Bind ViewModel.AvailableCountries}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCountry, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Select Country" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="Currency" Style="{StaticResource StatLabelTextStyle}" />
                                <ComboBox x:Name="CurrencyComboBox"
                                          ItemsSource="{x:Bind ViewModel.AvailableCurrencies}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Select Currency" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Submit Button -->
                    <Button
                        x:Name="RegisterButton"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Margin="0,4,0,0"
                        Click="RegisterButton_Click"
                        Command="{x:Bind ViewModel.RegisterCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Create Account" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <MenuFlyoutSeparator Margin="0,2" />

                    <!-- Back to Login -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="Already registered?" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Sign In" Command="{x:Bind ViewModel.NavigateToLoginCommand}" Padding="4,2" />
                        </StackPanel>

                        <!-- Company Brand -->
                        <TextBlock Text="Crafted by Santara" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
