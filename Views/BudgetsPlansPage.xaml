<Page
    x:Class="TheRichScript_WinUI.Views.BudgetsPlansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- 1. Header Row (Title on Left, Actions on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Budgets &amp; Recurring Plans" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddSubscription_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="New Subscription" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderButtonStyle}" Click="AddRecurringPlan_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72A;" FontSize="11" />
                            <TextBlock Text="New Recurring Plan" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderButtonStyle}" Click="AddQuickAdd_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE945;" FontSize="11" />
                            <TextBlock Text="New Template" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadPlansCommand}" ToolTipService.ToolTip="Refresh Plans">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. Summary KPI Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Monthly Subscriptions (Auto-Expenses) -->
                <controls:KpiCardControl
                    Grid.Column="0"
                    Title="Subscriptions"
                    Value="{x:Bind ViewModel.TotalMonthlySubscriptions, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Recurring auto-expenses"
                    Glyph="&#xEF42;"
                    ShowActionIcon="False" />

                <!-- 2. Monthly Recurring Transfers (Asset Transfers) -->
                <controls:KpiCardControl
                    Grid.Column="1"
                    Title="Recurring Transfers"
                    Value="{x:Bind ViewModel.TotalMonthlyRecurringTransfers, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Scheduled account transfers"
                    Glyph="&#xE72A;"
                    ShowActionIcon="False" />

                <!-- 3. Total Monthly Committed -->
                <controls:KpiCardControl
                    Grid.Column="2"
                    Title="Total Committed"
                    Value="{x:Bind ViewModel.TotalMonthlyCommitments, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Monthly automated outflow"
                    Glyph="&#xEAFC;"
                    ShowActionIcon="False" />

                <!-- 4. Total Active Plans Count -->
                <controls:KpiCardControl
                    Grid.Column="3"
                    Title="Active Plans"
                    Value="{x:Bind ViewModel.ActivePlansCount, Mode=OneWay}"
                    Subtitle="Enrolled commitments"
                    Glyph="&#xE8FD;"
                    ShowActionIcon="False" />
            </Grid>

            <!-- 3. Subscriptions Section (Auto-Expenses) -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="16,14">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Subscriptions (Auto Expenses)" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.Subscriptions.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="ProcessDueTransfers_Click" Padding="8,3" FontSize="11" ToolTipService.ToolTip="Process and record any subscriptions that are due">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                    <TextBlock Text="Process Due Bills" />
                                </StackPanel>
                            </Button>
                            <HyperlinkButton Content="+ New Subscription" Click="AddSubscription_Click" Padding="4,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="No active subscriptions. Subscriptions automate recurring payments like Netflix, gym memberships, rent, or utilities."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Visibility="{x:Bind ViewModel.Subscriptions.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <ListView ItemsSource="{x:Bind ViewModel.Subscriptions, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlannedExpense">
                                <Grid Padding="6,8" ColumnSpacing="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Subscription Glyph -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEF42;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name & Category -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <Border HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{x:Bind Category}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Source Account / Paid from -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE8C7;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind SourceAccountDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Frequency Badge -->
                                    <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind DisplayFrequency}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Next Due Date -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Next Due" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="4,0" Visibility="{x:Bind IsDueNow, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="DUE" FontSize="8" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind NextDueDate, Converter={StaticResource DateTimeFormatConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <!-- Amount -->
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                        <Run Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" />
                                    </TextBlock>

                                    <!-- Actions: 3-Dots Options Menu -->
                                    <Button Grid.Column="6"
                                            Padding="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Options">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit Subscription" Click="EditSubscription_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete Subscription" Click="DeletePlan_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 4. Recurring Plans Section (Asset Transfers) -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="16,14">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Recurring Plans (Asset Transfers)" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.RecurringPlans.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="ProcessDueTransfers_Click" Padding="8,3" FontSize="11" ToolTipService.ToolTip="Process and execute any recurring transfers that are due">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                    <TextBlock Text="Process Due Plans" />
                                </StackPanel>
                            </Button>
                            <HyperlinkButton Content="+ New Recurring Plan" Click="AddRecurringPlan_Click" Padding="4,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="No recurring transfer plans yet. Automate money transfers from one asset to another at scheduled intervals (e.g. Monthly SIP, savings deposits, investment transfers)."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"
                               Visibility="{x:Bind ViewModel.RecurringPlans.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <ListView ItemsSource="{x:Bind ViewModel.RecurringPlans, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PlannedExpense">
                                <Grid Padding="6,8" ColumnSpacing="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Transfer Glyph -->
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE72A;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Name & Category -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <Border HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{x:Bind Category}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Transfer Flow Badge: [From Asset] ➔ [To Asset] -->
                                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72A;" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind TransferFlowDisplay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Frequency Badge -->
                                    <Border Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind DisplayFrequency}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Next Due Date -->
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Next Date" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="4,0" Visibility="{x:Bind IsDueNow, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="DUE" FontSize="8" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind NextDueDate, Converter={StaticResource DateTimeFormatConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>

                                    <!-- Amount -->
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}">
                                        <Run Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" />
                                    </TextBlock>

                                    <!-- Actions: 3-Dots Options Menu -->
                                    <Button Grid.Column="6"
                                            Padding="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Options">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Edit Recurring Plan" Click="EditRecurringPlan_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE70F;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Delete Recurring Plan" Click="DeletePlan_Click" Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- 5. Quick Add Templates Section using StaggeredLayout -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="16,14">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Quick Add Templates" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" VerticalAlignment="Center" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ManualPlans.Count, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <HyperlinkButton Content="+ New Template" Click="AddQuickAdd_Click" HorizontalAlignment="Right" Padding="4,0" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="No Quick Add templates yet. Create templates to log recurring manual expenses or incomes with a single tap." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="{x:Bind ViewModel.ManualPlans.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <!-- StaggeredLayout for Quick Add Templates -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ManualPlans, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="240" MaxColumns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlannedExpense">
                                <Border Style="{StaticResource FluentSubtleCardStyle}" Padding="14,12" CornerRadius="8">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Category}" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <!-- 3-Dots Options Menu -->
                                            <Button HorizontalAlignment="Right"
                                                    Padding="4"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Options">
                                                <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Edit Template" Click="EditTemplate_Click" Tag="{x:Bind}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE70F;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Delete Template" Click="DeletePlan_Click" Tag="{x:Bind}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE74D;" />
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>

                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
