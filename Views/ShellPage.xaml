<Page
    x:Class="TheRichScript_WinUI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Auto"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="260"
            ExpandedModeThresholdWidth="900"
            CompactModeThresholdWidth="900"
            DisplayModeChanged="NavView_DisplayModeChanged"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <!-- Windows 11 Settings App Account Header at Top of Pane -->
            <NavigationView.PaneHeader>
                <Grid Margin="12,14,12,14" ColumnSpacing="14" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <PersonPicture
                        Width="44"
                        Height="44"
                        DisplayName="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                        Initials="{x:Bind ViewModel.Initials, Mode=OneWay}"
                        ProfilePicture="{x:Bind ViewModel.ProfilePictureImage, Mode=OneWay}"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock
                            Text="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
                            FontWeight="SemiBold"
                            FontSize="15"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="170" />
                        <TextBlock
                            Text="{x:Bind ViewModel.DisplayEmail, Mode=OneWay}"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            MaxWidth="170" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_dashboard.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Transactions" Tag="Transactions">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_transactions.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Assets &amp; Accounts" Tag="Assets">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_assets.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Income Sources" Tag="IncomeSources">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_income.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Budgets &amp; Plans" Tag="BudgetsPlans">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_budgets.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Goals" Tag="Goals">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_goals.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Debts &amp; Loans" Tag="Debts">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_debts.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Analytics &amp; Trends" Tag="Analytics">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_analytics.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Categories &amp; Limits" Tag="Categories">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_categories.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <ImageIcon Source="ms-appx:///Assets/Icons/nav_settings.png" Width="20" Height="20" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Content Area Frame -->
            <Frame x:Name="ContentFrame">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition />
                    </TransitionCollection>
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

        <!-- Global Action Processing Overlay & Interaction Blocker -->
        <Grid
            x:Name="ActionProcessingOverlay"
            Background="#66000000"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
            Canvas.ZIndex="999"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ContentDialogBackground}"
                BorderBrush="{ThemeResource ContentDialogBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="32,24"
                MinWidth="280"
                MaxWidth="420">

                <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Animated Fluent Accent ProgressRing -->
                    <ProgressRing
                        Width="36"
                        Height="36"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        HorizontalAlignment="Center" />

                    <!-- Action Status Message -->
                    <TextBlock
                        Text="{x:Bind ViewModel.BusyMessage, Mode=OneWay}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <!-- Subtitle Hint -->
                    <TextBlock
                        Text="Please wait a moment..."
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
