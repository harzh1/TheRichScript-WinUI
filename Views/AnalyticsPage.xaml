<Page
    x:Class="TheRichScript_WinUI.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,20">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 1. Header Row (Title on Left, Month Picker + Refresh on Right) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Financial Analytics" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <DropDownButton x:Name="MonthPickerDropDown" Style="{StaticResource SmallHeaderButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE787;" FontSize="11" />
                            <TextBlock Text="{x:Bind ViewModel.FormattedSelectedMonth, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="10" Width="220" Padding="4">
                                    <!-- Year Navigation Row -->
                                    <Grid>
                                        <Button Padding="6,4" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.PreviousYearCommand}" HorizontalAlignment="Left">
                                            <FontIcon Glyph="&#xE76B;" FontSize="10" />
                                        </Button>
                                        <TextBlock Text="{x:Bind ViewModel.PickerYear, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Button Padding="6,4" Background="Transparent" BorderThickness="0" Command="{x:Bind ViewModel.NextYearCommand}" HorizontalAlignment="Right">
                                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                                        </Button>
                                    </Grid>

                                    <!-- 4x3 Month Buttons Grid -->
                                    <Grid ColumnSpacing="6" RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0" Content="Jan" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="1" />
                                        <Button Grid.Row="0" Grid.Column="1" Content="Feb" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="2" />
                                        <Button Grid.Row="0" Grid.Column="2" Content="Mar" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="3" />

                                        <Button Grid.Row="1" Grid.Column="0" Content="Apr" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="4" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="May" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="5" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="Jun" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="6" />

                                        <Button Grid.Row="2" Grid.Column="0" Content="Jul" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="7" />
                                        <Button Grid.Row="2" Grid.Column="1" Content="Aug" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="8" />
                                        <Button Grid.Row="2" Grid.Column="2" Content="Sep" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="9" />

                                        <Button Grid.Row="3" Grid.Column="0" Content="Oct" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="10" />
                                        <Button Grid.Row="3" Grid.Column="1" Content="Nov" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="11" />
                                        <Button Grid.Row="3" Grid.Column="2" Content="Dec" HorizontalAlignment="Stretch" Padding="4,6" FontSize="12" Click="MonthButton_Click" Tag="12" />
                                    </Grid>

                                    <!-- Current Month Quick Shortcut -->
                                    <Button Content="Current Month" HorizontalAlignment="Stretch" Padding="4,4" FontSize="11" Click="CurrentMonthButton_Click" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadAnalyticsDataCommand}" ToolTipService.ToolTip="Refresh Analytics">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 2. Selected Month KPI Summary Cards (4 Columns) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Month Income -->
                <controls:KpiCardControl
                    Grid.Column="0"
                    Title="Month Income"
                    Value="{x:Bind ViewModel.AnalyticsData.MonthIncome, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Recorded cash inflows"
                    Glyph="&#xEAFC;"
                    ShowActionIcon="False" />

                <!-- 2. Month Expense -->
                <controls:KpiCardControl
                    Grid.Column="1"
                    Title="Month Expenses"
                    Value="{x:Bind ViewModel.AnalyticsData.MonthExpense, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Recorded cash outflows"
                    Glyph="&#xEF42;"
                    ShowActionIcon="False" />

                <!-- 3. Month Net Savings -->
                <controls:KpiCardControl
                    Grid.Column="2"
                    Title="Net Savings"
                    Value="{x:Bind ViewModel.AnalyticsData.MonthNetSavings, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Retained cash balance"
                    Glyph="&#xE8D4;"
                    ShowActionIcon="False" />

                <!-- 4. Savings Rate % -->
                <controls:KpiCardControl
                    Grid.Column="3"
                    Title="Savings Rate"
                    Value="{x:Bind ViewModel.FormattedSavingsRate, Mode=OneWay}"
                    Subtitle="Percentage of income saved"
                    Glyph="&#xE809;"
                    ShowActionIcon="False" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 3. Daily Spending Flow Chart -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Daily Spending Activity" Style="{StaticResource SectionHeaderTextStyle}" FontSize="16" />
                            <TextBlock Text="{x:Bind ViewModel.DailySpendingSubtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <!-- Multi-Series Category DropDown with Checkboxes -->
                        <DropDownButton Grid.Column="1" Style="{StaticResource SmallHeaderButtonStyle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE71C;" FontSize="11" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedSeriesSummary, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="230" Spacing="6" Padding="4">
                                        <!-- Header & Quick Actions -->
                                        <Grid Margin="4,2,4,4">
                                            <TextBlock Text="VISIBLE SERIES" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <HyperlinkButton Content="All" Command="{x:Bind ViewModel.SelectAllCategoryFiltersCommand}" Padding="2,0" FontSize="11" />
                                                <TextBlock Text="|" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="11" VerticalAlignment="Center" />
                                                <HyperlinkButton Content="Reset" Command="{x:Bind ViewModel.ResetCategoryFiltersCommand}" Padding="2,0" FontSize="11" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,4" />

                                        <!-- Filter Items with Checkboxes & Color Indicators -->
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.DailyCategoryFilters, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DailySpendingCategoryFilter">
                                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                              Margin="0,1"
                                                              Padding="8,0,0,0"
                                                              HorizontalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <Border Width="8" Height="8" CornerRadius="4" Background="{x:Bind ColorBrush}" />
                                                            <TextBlock Text="{x:Bind Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- Empty State -->
                    <TextBlock Text="No spending activity recorded for this month."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,12"
                               Visibility="{x:Bind ViewModel.HasDailySpending, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <!-- LiveCharts2 CartesianChart -->
                    <lvc:CartesianChart
                        Height="220"
                        Background="Transparent"
                        Series="{x:Bind ViewModel.DailySpendingSeries, Mode=OneWay}"
                        XAxes="{x:Bind ViewModel.DailySpendingXAxes, Mode=OneWay}"
                        YAxes="{x:Bind ViewModel.DailySpendingYAxes, Mode=OneWay}"
                        TooltipPosition="Top"
                        EasingFunction="{x:Bind ViewModel.ChartEasing, Mode=OneWay}"
                        AnimationsSpeed="00:00:00.550"
                        Visibility="{x:Bind ViewModel.HasDailySpending, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 4. Spending by Category (Donut + Side Table) -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,16">
                <StackPanel Spacing="14">
                    <TextBlock Text="Spending by Category" Style="{StaticResource SectionHeaderTextStyle}" FontSize="16" />

                    <!-- Empty State -->
                    <TextBlock Text="No category expenses recorded for the selected month."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,8"
                               Visibility="{x:Bind ViewModel.HasCategoryData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                    <!-- Donut + Table Container -->
                    <Grid ColumnSpacing="24"
                          Visibility="{x:Bind ViewModel.HasCategoryData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Donut Chart with Centered Total Overlay -->
                        <Grid Grid.Column="0" Height="210" Width="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- LiveCharts2 PieChart -->
                            <lvc:PieChart
                                Background="Transparent"
                                Series="{x:Bind ViewModel.CategoryPieSeries, Mode=OneWay}"
                                EasingFunction="{x:Bind ViewModel.ChartEasing, Mode=OneWay}"
                                AnimationsSpeed="00:00:00.650"
                                TooltipPosition="Hidden" />

                            <!-- Donut Hole Center Text -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
                                <TextBlock Text="TOTAL SPENT" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.FormattedTotalExpense, Mode=OneWay}" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                            </StackPanel>
                        </Grid>

                        <!-- Category Table -->
                        <ListView Grid.Column="1" ItemsSource="{x:Bind ViewModel.CategoryBreakdown, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategorySpendingSummary">
                                    <Grid Padding="4,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: Category Name + Dot on Left, Percentage + Amount on Right -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Dot + Category Name -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{x:Bind ColorBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind CategoryName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Right: Percentage Badge + Amount -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{x:Bind PercentageOfTotal, Converter={StaticResource PercentTextConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Full-Width Colored Progress Bar -->
                                        <ProgressBar Grid.Row="1" Value="{x:Bind PercentageOfTotal}" Maximum="100" Height="4" CornerRadius="2" Margin="0,6,0,2" Foreground="{x:Bind ColorBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 5. Goals Progress Section -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,16"
                    Visibility="{x:Bind ViewModel.HasGoalsData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="14">
                    <Grid>
                        <TextBlock Text="Goals Contribution &amp; Progress" Style="{StaticResource SectionHeaderTextStyle}" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="Active Savings Targets" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.GoalsProgress, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GoalProgressItem">
                                <Grid Padding="6,10" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Goal Name + Amount -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind CurrentAmount, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="/" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{x:Bind TargetAmount, Converter={StaticResource CurrencyConverter}}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                    <Run Text="{x:Bind ProgressPercentage, Converter={StaticResource PercentTextConverter}}" />
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <ProgressBar Grid.Row="1" Value="{x:Bind ProgressPercentage}" Maximum="100" Height="6" CornerRadius="3" Margin="0,8,0,2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Bottom Spacing -->
            <Border Height="20" />

        </StackPanel>
    </ScrollViewer>
</Page>
