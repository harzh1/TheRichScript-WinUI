<Page
    x:Class="TheRichScript_WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,0">
        <StackPanel Spacing="16" MaxWidth="1400">

            <!-- Page Title -->
            <StackPanel Spacing="2" Margin="0,0,0,4">
                <TextBlock Text="Settings" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Manage your profile, preferences, and account security" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
            </StackPanel>

            <!-- User Profile Header Banner & Photo Management -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="24,20" CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Clickable Avatar / PersonPicture with Hover Visual -->
                    <Button
                        Click="Avatar_Click"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="36"
                        ToolTipService.ToolTip="Click to view profile picture">
                        <Grid Width="68" Height="68">
                            <PersonPicture
                                Width="68"
                                Height="68"
                                DisplayName="{x:Bind ViewModel.FirstName, Mode=OneWay}"
                                Initials="{x:Bind ViewModel.Initials, Mode=OneWay}"
                                ProfilePicture="{x:Bind ViewModel.ProfilePictureImage, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

                            <!-- Uploading indicator overlay -->
                            <Border
                                Width="68"
                                Height="68"
                                CornerRadius="34"
                                Background="#80000000"
                                Visibility="{x:Bind ViewModel.IsUploadingAvatar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsUploadingAvatar, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsUploadingAvatar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>

                    <!-- User Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.FirstName, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.LastName, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Email, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Photo & Account Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Click="UploadAvatar_Click"
                            IsEnabled="{x:Bind ViewModel.IsUploadingAvatar, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="12,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="13" />
                                <TextBlock Text="Upload Photo" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{x:Bind ViewModel.RemoveAvatarCommand}"
                            IsEnabled="{x:Bind ViewModel.IsUploadingAvatar, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                            Visibility="{x:Bind ViewModel.HasAvatar, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Padding="10,7">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#EF4444" />
                                <TextBlock Text="Remove" FontSize="12" Foreground="#EF4444" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{x:Bind ViewModel.LogoutCommand}"
                            Padding="12,7"
                            Background="#1AF43F5E"
                            BorderBrush="#40F43F5E"
                            ToolTipService.ToolTip="Sign out of your account">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7E8;" FontSize="13" Foreground="#F43F5E" />
                                <TextBlock Text="Sign Out" FontSize="12" Foreground="#F43F5E" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Personal Details Card -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,18" CornerRadius="8">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Personal Details" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" />
                        <TextBlock Text="Update your display name, country, and default currency" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <Grid ColumnSpacing="16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- First Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                            <TextBlock Text="First Name" Style="{StaticResource StatLabelTextStyle}" FontSize="11" />
                            <TextBox Text="{x:Bind ViewModel.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter first name" />
                        </StackPanel>

                        <!-- Last Name -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                            <TextBlock Text="Last Name" Style="{StaticResource StatLabelTextStyle}" FontSize="11" />
                            <TextBox Text="{x:Bind ViewModel.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Enter last name" />
                        </StackPanel>

                        <!-- Country -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                            <TextBlock Text="Country Code" Style="{StaticResource StatLabelTextStyle}" FontSize="11" />
                            <TextBox Text="{x:Bind ViewModel.Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. IN, US, UK" />
                        </StackPanel>

                        <!-- Currency -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                            <TextBlock Text="Preferred Currency" Style="{StaticResource StatLabelTextStyle}" FontSize="11" />
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.AvailableCurrencies}" SelectedItem="{x:Bind ViewModel.Currency, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveProfileCommand}" IsEnabled="{x:Bind ViewModel.IsSavingProfile, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" HorizontalAlignment="Left" Padding="16,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsSavingProfile, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSavingProfile, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Save Profile Changes" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Appearance Card -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,18" CornerRadius="8">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" />
                        <TextBlock Text="Customize the visual look and theme of the application" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="App Theme" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="Select Light, Dark, or match Windows System theme" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                        </StackPanel>

                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.AvailableThemes}" SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" SelectionChanged="ThemeComboBox_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Security & Password Card -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,18" CornerRadius="8">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Security &amp; Password" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" />
                        <TextBlock Text="Change your account login password" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Current Password" Style="{StaticResource StatLabelTextStyle}" FontSize="11" />
                            <PasswordBox x:Name="CurrentPasswordBox" PlaceholderText="Enter current password" PasswordRevealMode="Peek" PasswordChanged="CurrentPasswordBox_PasswordChanged" />
                        </StackPanel>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock Text="New Password (min 6 characters)" Style="{StaticResource StatLabelTextStyle}" FontSize="11" />
                                <PasswordBox x:Name="NewPasswordBox" PlaceholderText="Enter new password" PasswordRevealMode="Peek" PasswordChanged="NewPasswordBox_PasswordChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="Confirm New Password" Style="{StaticResource StatLabelTextStyle}" FontSize="11" />
                                <PasswordBox x:Name="ConfirmPasswordBox" PlaceholderText="Re-enter new password" PasswordRevealMode="Peek" PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Button Command="{x:Bind ViewModel.ChangePasswordCommand}" IsEnabled="{x:Bind ViewModel.IsUpdatingPassword, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}" HorizontalAlignment="Left" Padding="16,7">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsUpdatingPassword, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsUpdatingPassword, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Change Password" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Automation & Data Sync Card -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,18" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Recurring Schedules &amp; Automation" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" />
                        <TextBlock Text="Manually trigger server-side recurring plans and auto-funding schedules right now" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Command="{x:Bind ViewModel.RunCronJobsCommand}"
                        IsEnabled="{x:Bind ViewModel.IsSyncing, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                        Padding="14,7"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsSyncing, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsSyncing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{x:Bind ViewModel.IsSyncing, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            <TextBlock Text="Sync Recurring" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>


            <!-- About & Santara Branding Card -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,16" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="RichScript" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Crafted by Santara • Native Windows Financial Workspace" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#1A10B981" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="Santara" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" />
                    </Border>
                </Grid>
            </Border>

            <!-- Danger Zone Card -->
            <Border Style="{StaticResource FluentCardStyle}" Padding="20,18" CornerRadius="8" BorderBrush="#40EF4444" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#EF4444" />
                            <TextBlock Text="Danger Zone" Style="{StaticResource SectionHeaderTextStyle}" FontSize="15" Foreground="#EF4444" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Irreversible actions for your workspace data and account" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                    </StackPanel>

                    <!-- Reset All Data -->
                    <Grid Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Reset All Financial Data" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Permanently erase all transactions, assets, budgets, debts, and goals while keeping your account active." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Click="ResetData_Click"
                            IsEnabled="{x:Bind ViewModel.IsResettingData, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="14,7"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsResettingData, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsResettingData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#F59E0B" Visibility="{x:Bind ViewModel.IsResettingData, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock Text="Reset Data" Foreground="#F59E0B" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Delete Account -->
                    <Grid Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Delete Account" FontWeight="SemiBold" FontSize="13" Foreground="#EF4444" />
                            <TextBlock Text="Permanently delete your account, login credentials, and all personal &amp; financial cloud records." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Click="DeleteAccount_Click"
                            IsEnabled="{x:Bind ViewModel.IsDeletingAccount, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}"
                            Padding="14,7"
                            VerticalAlignment="Center"
                            Background="#1AEF4444"
                            BorderBrush="#40EF4444">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsDeletingAccount, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsDeletingAccount, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <FontIcon Glyph="&#xE8FA;" FontSize="12" Foreground="#EF4444" Visibility="{x:Bind ViewModel.IsDeletingAccount, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock Text="Delete Account" Foreground="#EF4444" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
