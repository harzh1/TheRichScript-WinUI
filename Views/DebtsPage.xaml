<Page
    x:Class="TheRichScript_WinUI.Views.DebtsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- 1. Header Row (Title on Left, Actions & Toggle on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Debts &amp; Personal Loans" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Toggle to show/hide settled debts -->
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowSettledAndWrittenOff, Mode=TwoWay}"
                                  OnContent="Show Settled"
                                  OffContent="Active Only"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0" />

                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddDebt_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Record Debt" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadDebtsCommand}" ToolTipService.ToolTip="Refresh Debts">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. KPI Summary Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Money Lent -->
                <Border Grid.Column="0" Style="{StaticResource FluentCardStyle}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="MONEY LENT (RECEIVABLE)" Style="{StaticResource StatLabelTextStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.TotalLentPending, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Money Borrowed -->
                <Border Grid.Column="1" Style="{StaticResource FluentCardStyle}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="MONEY BORROWED (PAYABLE)" Style="{StaticResource StatLabelTextStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.TotalBorrowedPending, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Net Position -->
                <Border Grid.Column="2" Style="{StaticResource FluentCardStyle}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="NET RECEIVABLE POSITION" Style="{StaticResource StatLabelTextStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.NetReceivable, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Total Debt Records -->
                <Border Grid.Column="3" Style="{StaticResource FluentCardStyle}" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="TOTAL LOAN CONTRACTS" Style="{StaticResource StatLabelTextStyle}" FontSize="10" />
                        <TextBlock Text="{x:Bind ViewModel.TotalDebtsCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Pivot Section: Lent vs Borrowed with StaggeredLayout -->
            <Pivot Margin="0,-4,0,0">
                <!-- Lent Tab -->
                <PivotItem Header="Money Lent (Receivables)">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="No active lent records." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="{x:Bind ViewModel.FilteredLentDebts.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                        <!-- StaggeredLayout for Lent Debts -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredLentDebts, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="320" MaxColumns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Debt">
                                    <Border Style="{StaticResource FluentCardStyle}" Padding="14,12" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <!-- Top row: Person Name + Status Badge -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind PersonName}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Balance Info -->
                                            <Grid Margin="0,2,0,0">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Remaining Due" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind RemainingAmount, Converter={StaticResource CurrencyConverter}}" FontSize="17" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Spacing="1">
                                                    <TextBlock Text="Original Lent" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Value="{x:Bind SettlementPercentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                            <!-- Subtext -->
                                            <Grid>
                                                <TextBlock Text="{x:Bind DueDateText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="Settled: " /><Run Text="{x:Bind SettledAmount, Converter={StaticResource CurrencyConverter}}" />
                                                </TextBlock>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <Grid ColumnSpacing="6" Margin="0,2,0,0" Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" HorizontalAlignment="Stretch" Padding="6,4" Click="SettleDebt_Click" Tag="{x:Bind}">
                                                    <TextBlock Text="Record Payment" FontSize="11" />
                                                </Button>
                                                <Button Grid.Column="1" Style="{StaticResource SmallHeaderButtonStyle}" Padding="6,4" Click="WriteOffDebt_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Write Off Debt">
                                                    <TextBlock Text="Write Off" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </PivotItem>

                <!-- Borrowed Tab -->
                <PivotItem Header="Money Borrowed (Payables)">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="No active borrowed records. Click 'Record Debt' to track money you've borrowed." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="{x:Bind ViewModel.FilteredBorrowedDebts.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                        <!-- StaggeredLayout for Borrowed Debts -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredBorrowedDebts, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="320" MaxColumns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Debt">
                                    <Border Style="{StaticResource FluentCardStyle}" Padding="14,12" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <!-- Top row: Person Name + Status Badge -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                        <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind PersonName}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="180" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <Border Grid.Column="1" HorizontalAlignment="Right" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>

                                            <!-- Balance Info -->
                                            <Grid Margin="0,2,0,0">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Remaining Payable" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind RemainingAmount, Converter={StaticResource CurrencyConverter}}" FontSize="17" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Spacing="1">
                                                    <TextBlock Text="Original Borrowed" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Value="{x:Bind SettlementPercentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                            <!-- Subtext -->
                                            <Grid>
                                                <TextBlock Text="{x:Bind DueDateText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="Paid: " /><Run Text="{x:Bind SettledAmount, Converter={StaticResource CurrencyConverter}}" />
                                                </TextBlock>
                                            </Grid>

                                            <!-- Action Button -->
                                            <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,2,0,0" Padding="6,4" Click="SettleDebt_Click" Tag="{x:Bind}" Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Pay Debt" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </PivotItem>
            </Pivot>

        </StackPanel>
    </ScrollViewer>
</Page>
