<Page
    x:Class="TheRichScript_WinUI.Views.DebtsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TheRichScript_WinUI.Models"
    xmlns:controls="using:TheRichScript_WinUI.Controls"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,0">
        <StackPanel Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">

            <!-- 1. Header Row (Title on Left, Actions & Toggle on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Debts &amp; Personal Loans" Style="{StaticResource PageHeaderTextStyle}" FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Toggle to show/hide settled debts -->
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowSettledAndWrittenOff, Mode=TwoWay}"
                                  OnContent="Show Settled"
                                  OffContent="Active Only"
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Margin="0,0,4,0" />

                    <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" Click="AddDebt_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE710;" FontSize="11" />
                            <TextBlock Text="Record Debt" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SmallHeaderIconButton}" Command="{x:Bind ViewModel.LoadDebtsCommand}" ToolTipService.ToolTip="Refresh Debts">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 2. KPI Summary Metric Cards: 4 Compact Cards in 1 Row -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1. Money Lent -->
                <controls:KpiCardControl
                    Grid.Column="0"
                    Title="Money Lent"
                    Value="{x:Bind ViewModel.TotalLentPending, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Receivable from borrowers"
                    Glyph="&#xE896;"
                    ShowActionIcon="False" />

                <!-- 2. Money Borrowed -->
                <controls:KpiCardControl
                    Grid.Column="1"
                    Title="Money Borrowed"
                    Value="{x:Bind ViewModel.TotalBorrowedPending, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Payable to lenders"
                    Glyph="&#xE898;"
                    ShowActionIcon="False" />

                <!-- 3. Net Position -->
                <controls:KpiCardControl
                    Grid.Column="2"
                    Title="Net Receivable"
                    Value="{x:Bind ViewModel.NetReceivable, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                    Subtitle="Lent minus borrowed balance"
                    Glyph="&#xE8D4;"
                    ShowActionIcon="False" />

                <!-- 4. Total Debt Records -->
                <controls:KpiCardControl
                    Grid.Column="3"
                    Title="Total Loans"
                    Value="{x:Bind ViewModel.TotalDebtsCount, Mode=OneWay}"
                    Subtitle="Active loan contracts"
                    Glyph="&#xE7C1;"
                    ShowActionIcon="False" />
            </Grid>

            <!-- 3. Pivot Section: Lent vs Borrowed with StaggeredLayout -->
            <Pivot Margin="0,-4,0,0">
                <!-- Lent Tab -->
                <PivotItem Header="Money Lent (Receivables)">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="No active lent records." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="{x:Bind ViewModel.FilteredLentDebts.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                        <!-- StaggeredLayout for Lent Debts -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredLentDebts, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="250" MaxColumns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Debt">
                                    <Border Style="{StaticResource FluentCardStyle}" Padding="14,12" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <!-- Top row: Person Name + Status Badge + 3-Dots Menu -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind PersonName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <!-- 3-Dots Options Menu -->
                                                    <Button Padding="4"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Options">
                                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Edit Record" Click="EditDebt_Click" Tag="{x:Bind}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE70F;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                                                <MenuFlyoutItem Text="Write Off Debt" Click="WriteOffDebt_Click" Tag="{x:Bind}" Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7BA;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Balance Info -->
                                            <Grid Margin="0,2,0,0">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Remaining Due" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedRemaining}" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedBaseRemaining}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowBaseValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Spacing="1">
                                                    <TextBlock Text="Original Lent" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind FormattedAmount}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Value="{x:Bind SettlementPercentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                            <!-- Subtext -->
                                            <Grid>
                                                <TextBlock Text="{x:Bind DueDateText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="Settled: " /><Run Text="{x:Bind FormattedSettledAmount}" />
                                                </TextBlock>
                                            </Grid>

                                            <!-- Action Button -->
                                            <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,2,0,0" Padding="6,4" Click="SettleDebt_Click" Tag="{x:Bind}" Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Record Payment" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </PivotItem>

                <!-- Borrowed Tab -->
                <PivotItem Header="Money Borrowed (Payables)">
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <TextBlock Text="No active borrowed records. Click 'Record Debt' to track money you've borrowed." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Visibility="{x:Bind ViewModel.FilteredBorrowedDebts.Count, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                        <!-- StaggeredLayout for Borrowed Debts -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredBorrowedDebts, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:StaggeredPanel ColumnSpacing="12" RowSpacing="12" DesiredColumnWidth="250" MaxColumns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Debt">
                                    <Border Style="{StaticResource FluentCardStyle}" Padding="14,12" CornerRadius="8">
                                        <StackPanel Spacing="10">
                                            <!-- Top row: Person Name + Status Badge + 3-Dots Menu -->
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind PersonName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind StatusBadgeText}" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Border>

                                                    <!-- 3-Dots Options Menu -->
                                                    <Button Padding="4"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Options">
                                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Button.Flyout>
                                                            <MenuFlyout>
                                                                <MenuFlyoutItem Text="Edit Record" Click="EditDebt_Click" Tag="{x:Bind}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE70F;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                                                <MenuFlyoutItem Text="Write Off Debt" Click="WriteOffDebt_Click" Tag="{x:Bind}" Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE7BA;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Balance Info -->
                                            <Grid Margin="0,2,0,0">
                                                <StackPanel Spacing="1">
                                                    <TextBlock Text="Remaining Payable" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedRemaining}" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedBaseRemaining}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ShowBaseValue, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Spacing="1">
                                                    <TextBlock Text="Original Borrowed" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind FormattedAmount}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Progress Bar -->
                                            <ProgressBar Value="{x:Bind SettlementPercentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                            <!-- Subtext -->
                                            <Grid>
                                                <TextBlock Text="{x:Bind DueDateText}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center">
                                                    <Run Text="Paid: " /><Run Text="{x:Bind FormattedSettledAmount}" />
                                                </TextBlock>
                                            </Grid>

                                            <!-- Action Button -->
                                            <Button Style="{StaticResource SmallHeaderAccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,2,0,0" Padding="6,4" Click="SettleDebt_Click" Tag="{x:Bind}" Visibility="{x:Bind IsSettled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                                <TextBlock Text="Pay Debt" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </PivotItem>
            </Pivot>

        </StackPanel>
    </ScrollViewer>
</Page>
