<Page
    x:Class="TheRichScript_WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:TheRichScript_WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="420"
                Margin="0,30,0,30"
                Style="{StaticResource FluentCardStyle}"
                Padding="32,28">

                <StackPanel Spacing="18">
                    <!-- App Header -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,4">
                        <Image Source="ms-appx:///Assets/Square150x150Logo.scale-200.png"
                               Width="56" Height="56"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="RichScript" Style="{StaticResource PageHeaderTextStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Sign in to your native finance workspace" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Error InfoBar -->
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToBoolConverter}}"
                        Severity="Error"
                        Title="Login Failed"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        IsClosable="False" />

                    <!-- Form Fields -->
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Email Address" Style="{StaticResource StatLabelTextStyle}" />
                            <TextBox x:Name="EmailBox"
                                     Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="name@example.com"
                                     KeyDown="EmailBox_KeyDown" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Password" Style="{StaticResource StatLabelTextStyle}" />
                            <PasswordBox x:Name="PasswordBox"
                                         PlaceholderText="••••••••"
                                         PasswordRevealMode="Peek"
                                         KeyDown="PasswordBox_KeyDown"
                                         PasswordChanged="PasswordBox_PasswordChanged" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Action Button -->
                    <Button
                        x:Name="SignInButton"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        Margin="0,4,0,0"
                        Click="SignInButton_Click"
                        Command="{x:Bind ViewModel.LoginCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.LoadingStatusText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <MenuFlyoutSeparator Margin="0,2" />

                    <!-- Footer Navigation -->
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="Don't have an account?" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Create Account" Command="{x:Bind ViewModel.NavigateToRegisterCommand}" Padding="4,2" />
                        </StackPanel>

                        <!-- Company Brand -->
                        <TextBlock Text="Crafted by Santara" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
