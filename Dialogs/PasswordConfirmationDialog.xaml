<ContentDialog
    x:Class="TheRichScript_WinUI.Dialogs.PasswordConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    CornerRadius="12"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <StackPanel Spacing="16" Width="400">
        <!-- Warning InfoBar -->
        <InfoBar
            x:Name="WarningInfoBar"
            IsOpen="True"
            IsClosable="False"
            Severity="Error"
            Title="Warning"
            Message="This action is permanent and cannot be undone." />

        <!-- Description Message -->
        <TextBlock
            x:Name="MessageTextBlock"
            TextWrapping="Wrap"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Password Confirmation Input -->
        <StackPanel Spacing="6">
            <TextBlock Text="Enter Your Current Password to Confirm" FontWeight="SemiBold" FontSize="12" />
            <PasswordBox
                x:Name="PasswordInputBox"
                PlaceholderText="Enter your account password"
                PasswordRevealMode="Peek" />
            <TextBlock
                x:Name="ValidationErrorText"
                Text="Password is required."
                Foreground="#EF4444"
                FontSize="11"
                Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
