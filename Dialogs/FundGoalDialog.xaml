<ContentDialog
    x:Class="TheRichScript_WinUI.Dialogs.FundGoalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Funds to Goal"
    PrimaryButtonText="Deposit Funds"
    CloseButtonText="Cancel"
    CornerRadius="12"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="380">
        <!-- Validation Error Bar -->
        <InfoBar x:Name="DialogErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />

        <TextBlock x:Name="GoalInfoText" Text="Deposit funds towards your goal" Style="{StaticResource StatLabelTextStyle}" />

        <!-- Source Asset -->
        <StackPanel Spacing="6">
            <TextBlock Text="Source Account (Funds drawn from)" Style="{StaticResource StatLabelTextStyle}" />
            <ComboBox x:Name="AssetComboBox" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayNameWithBalance" SelectedValuePath="Id" />
        </StackPanel>

        <!-- Destination Deposit Account -->
        <StackPanel Spacing="4">
            <TextBlock Text="Deposit Account (Destination)" Style="{StaticResource StatLabelTextStyle}" />
            <TextBlock x:Name="DestinationAccountText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Amount -->
        <StackPanel Spacing="6">
            <TextBlock x:Name="AmountLabel" Text="Deposit Amount" Style="{StaticResource StatLabelTextStyle}" />
            <NumberBox x:Name="AmountNumberBox" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" PlaceholderText="0.00" />
        </StackPanel>

        <!-- Cross-Currency Funding FX (Visible when source asset currency != goal currency) -->
        <Border x:Name="FxPanel" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock x:Name="FxExplanationText" Text="Currencies differ. Custom credited amount or rate is optional; backend applies live rates if omitted." TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock x:Name="DestAmountLabel" Text="Goal Amount Credited" Style="{StaticResource StatLabelTextStyle}" />
                    <NumberBox x:Name="DestAmountNumberBox" Minimum="0" Value="NaN" SpinButtonPlacementMode="Inline" PlaceholderText="Optional credited amount..." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="ExchangeRateLabel" Text="Exchange Rate" Style="{StaticResource StatLabelTextStyle}" />
                    <NumberBox x:Name="ExchangeRateNumberBox" Minimum="0" Value="NaN" SpinButtonPlacementMode="Inline" PlaceholderText="Optional exchange rate..." />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
