<ContentDialog
    x:Class="TheRichScript_WinUI.Dialogs.FundGoalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add Funds to Goal"
    PrimaryButtonText="Deposit Funds"
    CloseButtonText="Cancel"
    CornerRadius="12"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="380">
        <TextBlock x:Name="GoalInfoText" Text="Deposit funds towards your goal" Style="{StaticResource StatLabelTextStyle}" />

        <!-- Source Asset -->
        <StackPanel Spacing="6">
            <TextBlock Text="Source Account / Asset" Style="{StaticResource StatLabelTextStyle}" />
            <ComboBox x:Name="AssetComboBox" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayNameWithBalance" SelectedValuePath="Id" />
        </StackPanel>

        <!-- Amount -->
        <StackPanel Spacing="6">
            <TextBlock Text="Deposit Amount" Style="{StaticResource StatLabelTextStyle}" />
            <NumberBox x:Name="AmountNumberBox" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" PlaceholderText="0.00" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
