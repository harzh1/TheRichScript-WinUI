<ContentDialog
    x:Class="TheRichScript_WinUI.Dialogs.SettleDebtDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settle Debt"
    PrimaryButtonText="Record Settlement"
    CloseButtonText="Cancel"
    CornerRadius="12"
    DefaultButton="Primary">

    <StackPanel Spacing="16" Width="380">
        <!-- Validation Error Bar -->
        <InfoBar x:Name="DialogErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />

        <TextBlock x:Name="DebtInfoText" Text="Settle debt" Style="{StaticResource StatLabelTextStyle}" />

        <!-- Account / Asset -->
        <StackPanel Spacing="6">
            <TextBlock x:Name="AssetLabel" Text="Receiving / Paying Account" Style="{StaticResource StatLabelTextStyle}" />
            <ComboBox x:Name="AssetComboBox" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayNameWithBalance" SelectedValuePath="Id" />
        </StackPanel>

        <!-- Settlement Amount -->
        <StackPanel Spacing="6">
            <TextBlock x:Name="AmountLabel" Text="Settlement Amount" Style="{StaticResource StatLabelTextStyle}" />
            <NumberBox x:Name="AmountNumberBox" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" PlaceholderText="0.00" />
        </StackPanel>

        <!-- Cross-Currency Settlement FX (Visible when asset currency != debt currency) -->
        <Border x:Name="FxPanel" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="12" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock x:Name="FxExplanationText" Text="Currencies differ. Custom settlement amount or rate is optional; backend applies live rates if omitted." TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <StackPanel Spacing="4">
                    <TextBlock x:Name="SettleAssetAmountLabel" Text="Account Amount Credited/Debited" Style="{StaticResource StatLabelTextStyle}" />
                    <NumberBox x:Name="SettleAssetAmountNumberBox" Minimum="0" Value="NaN" SpinButtonPlacementMode="Inline" PlaceholderText="Optional converted amount..." />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock x:Name="ExchangeRateLabel" Text="Exchange Rate" Style="{StaticResource StatLabelTextStyle}" />
                    <NumberBox x:Name="ExchangeRateNumberBox" Minimum="0" Value="NaN" SpinButtonPlacementMode="Inline" PlaceholderText="Optional exchange rate..." />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
