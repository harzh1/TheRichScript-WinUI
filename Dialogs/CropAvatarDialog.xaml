<ContentDialog
    x:Class="TheRichScript_WinUI.Dialogs.CropAvatarDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Adjust Profile Picture"
    PrimaryButtonText="Set Profile Photo"
    CloseButtonText="Cancel"
    CornerRadius="12"
    DefaultButton="Primary"
    PrimaryButtonClick="CropAvatarDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" Width="400">
        <!-- Subtitle & Instructions -->
        <TextBlock
            Text="Click and drag anywhere to center your face, and use the zoom slider or scroll wheel to adjust the size."
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            FontSize="12"
            TextWrapping="Wrap" />

        <!-- 360x360 Crop Viewport Frame -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Render Target Container with Direct Pointer Drag & Wheel Zoom (Exactly 360x360) -->
            <Grid
                x:Name="CropViewportContainer"
                Width="360"
                Height="360"
                Background="#141414"
                CornerRadius="8"
                PointerPressed="Viewport_PointerPressed"
                PointerMoved="Viewport_PointerMoved"
                PointerReleased="Viewport_PointerReleased"
                PointerCaptureLost="Viewport_PointerCaptureLost"
                PointerWheelChanged="Viewport_PointerWheelChanged">

                <!-- Transformable Source Image -->
                <Image
                    x:Name="SourceImage"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    ImageOpened="SourceImage_ImageOpened">
                    <Image.RenderTransform>
                        <CompositeTransform x:Name="ImageTransform" CenterX="180" CenterY="180" />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Circular Mask & Stencil Overlay (360x360, Click-through) -->
            <Grid
                x:Name="OverlayStencil"
                Width="360"
                Height="360"
                IsHitTestVisible="False">

                <!-- Dimmed Mask with 340px Circular Cutout -->
                <Path Fill="#A6000000">
                    <Path.Data>
                        <GeometryGroup FillRule="EvenOdd">
                            <RectangleGeometry Rect="0,0,360,360" />
                            <EllipseGeometry Center="180,180" RadiusX="170" RadiusY="170" />
                        </GeometryGroup>
                    </Path.Data>
                </Path>

                <!-- Circular Guide Ring -->
                <Ellipse
                    Width="340"
                    Height="340"
                    Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                    StrokeThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0.85" />
            </Grid>
        </Grid>

        <!-- Zoom Control & Controls Toolbar -->
        <StackPanel Spacing="8" Margin="0,4,0,0">
            <Grid ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Zoom Out Icon Button -->
                <Button
                    Grid.Column="0"
                    Click="ZoomOut_Click"
                    Padding="8,5"
                    ToolTipService.ToolTip="Zoom out">
                    <FontIcon Glyph="&#xE71F;" FontSize="13" />
                </Button>

                <!-- Zoom Slider -->
                <Slider
                    x:Name="ZoomSlider"
                    Grid.Column="1"
                    Minimum="1.0"
                    Maximum="4.0"
                    StepFrequency="0.05"
                    Value="1.0"
                    VerticalAlignment="Center"
                    ValueChanged="ZoomSlider_ValueChanged" />

                <!-- Zoom In Icon Button -->
                <Button
                    Grid.Column="2"
                    Click="ZoomIn_Click"
                    Padding="8,5"
                    ToolTipService.ToolTip="Zoom in">
                    <FontIcon Glyph="&#xE8A3;" FontSize="13" />
                </Button>

                <!-- Reset Button -->
                <Button
                    Grid.Column="3"
                    Click="ResetButton_Click"
                    Padding="10,5"
                    ToolTipService.ToolTip="Reset position and zoom">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                </Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</ContentDialog>
