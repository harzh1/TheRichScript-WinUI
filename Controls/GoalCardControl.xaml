<UserControl
    x:Class="TheRichScript_WinUI.Controls.GoalCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush x:Key="GoalCardAcrylicBackground"
                                  TintColor="#1C1C1E"
                                  TintOpacity="0.75"
                                  FallbackColor="#1C1C1E" />
                    <Color x:Key="GoalCardFallbackStart">#1E293B</Color>
                    <Color x:Key="GoalCardFallbackEnd">#0F172A</Color>
                    <SolidColorBrush x:Key="GoalCardFallbackIcon" Color="#334155" />
                    <SolidColorBrush x:Key="GoalCardGlassButtonBg" Color="#66000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="GoalCardAcrylicBackground"
                                  TintColor="#F8F9FA"
                                  TintOpacity="0.75"
                                  FallbackColor="#F8F9FA" />
                    <Color x:Key="GoalCardFallbackStart">#E2E8F0</Color>
                    <Color x:Key="GoalCardFallbackEnd">#CBD5E1</Color>
                    <SolidColorBrush x:Key="GoalCardFallbackIcon" Color="#94A3B8" />
                    <SolidColorBrush x:Key="GoalCardGlassButtonBg" Color="#55000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="GoalCardAcrylicBackground"
                                  TintColor="#1C1C1E"
                                  TintOpacity="0.75"
                                  FallbackColor="#1C1C1E" />
                    <Color x:Key="GoalCardFallbackStart">#1E293B</Color>
                    <Color x:Key="GoalCardFallbackEnd">#0F172A</Color>
                    <SolidColorBrush x:Key="GoalCardFallbackIcon" Color="#334155" />
                    <SolidColorBrush x:Key="GoalCardGlassButtonBg" Color="#66000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource FluentCardStyle}" Padding="0" CornerRadius="9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Top Section: 16:9 Media Banner with Smooth Sliding Carousel -->
            <Grid x:Name="ImageContainer" Grid.Row="0">
                <!-- Fallback Gradient when Goal has NO image -->
                <Grid x:Name="FallbackBackgroundGrid" Visibility="Collapsed">
                    <Border CornerRadius="8,8,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{ThemeResource GoalCardFallbackStart}" Offset="0.0" />
                                <GradientStop Color="{ThemeResource GoalCardFallbackEnd}" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <FontIcon Glyph="&#xE706;" FontSize="38" Foreground="{ThemeResource GoalCardFallbackIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- Full 16:9 Image Sliding Viewport -->
                <Border CornerRadius="8,8,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid x:Name="SlideshowViewport" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <!-- Current Visible Image -->
                        <Image x:Name="ImageCurrent" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image.RenderTransform>
                                <TranslateTransform x:Name="TransformCurrent" />
                            </Image.RenderTransform>
                        </Image>

                        <!-- Next Sliding-In Image (Pre-loaded and resident in memory) -->
                        <Image x:Name="ImageNext" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0">
                            <Image.RenderTransform>
                                <TranslateTransform x:Name="TransformNext" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Border>

                <!-- Subtle Top Gradient for Badges -->
                <Border CornerRadius="8,8,0,0" VerticalAlignment="Top" Height="35">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Top-Left Completed Badge (visible only when completed) -->
                <Border x:Name="CompletedBadge"
                        Background="{StaticResource IncomeGreenBrush}"
                        CornerRadius="4"
                        Padding="6,3"
                        Margin="8,8,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="White" />
                        <TextBlock Text="Completed" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- Slideshow Carousel Indicators -->
                <Border x:Name="SlideshowDotsBadge"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <StackPanel x:Name="DotsIndicatorPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- 2. Bottom Section: All Details Below the 16:9 Image -->
            <Border Grid.Row="1"
                    CornerRadius="0,0,8,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="12,10,12,11">
                <StackPanel Spacing="5">
                    <!-- Title & Menu Row -->
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Goal Name & Pinned Indicator (visible only when pinned) -->
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock x:Name="GoalNameText"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border x:Name="PinnedBadge"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Padding="4,1"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <FontIcon Glyph="&#xE840;" FontSize="8" Foreground="White" />
                                    <TextBlock Text="Pinned" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 3 Dots Options Menu -->
                        <Button x:Name="MoreMenuButton"
                                Grid.Column="1"
                                Padding="3"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Goal Options">
                            <FontIcon Glyph="&#xE712;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Deposit Funds" Click="DepositFundsButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE710;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="PinMenuItem" Text="Toggle Pin" Click="PinButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon x:Name="PinMenuIcon" Glyph="&#xE718;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Edit Goal" Click="EditButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Delete Goal" Click="DeleteButton_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Saved & Target Amounts Row -->
                    <Grid Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="SAVED" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="CurrentAmountText" FontSize="15" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="TARGET" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TargetAmountText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar x:Name="GoalProgressBar" Maximum="100" Height="4" CornerRadius="2" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" />

                    <!-- Progress Meta Row -->
                    <Grid Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressPercentageText" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="•" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="RemainingAmountText" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE787;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ExpectedDateText" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Recurring Auto-Funding Info -->
                    <Border x:Name="AutoFundingBorder" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE823;" FontSize="9" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="AutoFundingText" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- In-Progress Deposit Button -->
                    <Button x:Name="DepositFundsButton" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="8,4" Click="DepositFundsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="10" />
                            <TextBlock Text="Deposit Funds" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- Target Achieved Celebration Banner -->
                    <Border x:Name="CompletedBanner"
                            Background="{StaticResource IncomeGreenSubtleBrush}"
                            BorderBrush="{StaticResource IncomeGreenBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,4"
                            HorizontalAlignment="Stretch"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="{StaticResource IncomeGreenBrush}" />
                            <TextBlock Text="Target Achieved ✓" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource IncomeGreenBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
